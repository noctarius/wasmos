# Conservative clang-tidy policy for first-party C/C++ sources, used by the
# `lint` CMake target (scripts/quality.sh). The focus is correctness and real
# bug patterns (static analyzer + bugprone); style, readability, and
# portability opinions are intentionally left out to keep signal high on a
# hand-written, minimalist codebase. Two bugprone sub-checks are disabled as
# high-noise / low-value here. Findings are warnings, not build failures
# (WarningsAsErrors empty) — tighten deliberately once the baseline is clean.
Checks: >
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-core.FixedAddressDereference,
  -bugprone-casting-through-void,
  -bugprone-branch-clone,
  -bugprone-multi-level-implicit-pointer-conversion
# Only diagnose headers inside our own source tree; vendored libs/ headers
# (wasm3, warp) are pulled in via -I but must not be linted or modified.
HeaderFilterRegex: '/(src|tests|examples|scripts)/'
WarningsAsErrors: ''

# Disabled checks and why:
#   insecureAPI.DeprecatedOrUnsafeBufferHandling  fires on every memset/snprintf/
#     strncpy demanding C11 Annex K *_s variants, which are optional and absent
#     in this freestanding tree (pure noise: ~190 hits).
#   casting-through-void        wants C++ reinterpret_cast; casting through void*
#     is idiomatic C here.
#   branch-clone                flags intentional repeated arms (e.g. printf's
#     va_arg long/int cases).
#   multi-level-implicit-pointer-conversion  low value for this C codebase.
#   core.FixedAddressDereference  fires on legitimate MMIO register access
#     (*(volatile uint32_t *)(g_lapic_base + reg)); the kernel dereferences
#     fixed device addresses by design.
# implicit-widening-of-multiplication-result is intentionally KEPT: a u32*u32
#   used as a size_t offset can be a real 32-bit overflow worth catching.