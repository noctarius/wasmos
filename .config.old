
#
# Build Options
#

#
# Examples
#
CONFIG_AS_ENABLE=y
CONFIG_RUST_ENABLE=y
CONFIG_GO_ENABLE=y
CONFIG_ZIG_ENABLE=y
# end of Examples

# CONFIG_WASMOS_TRACE is not set
# CONFIG_WASMOS_RING3_SMOKE is not set
# CONFIG_WASMOS_RING3_THREAD_LIFECYCLE_SMOKE is not set
# CONFIG_WASMOS_PM_TEST_HOOKS is not set
CONFIG_WASMOS_PM_LIST_LINKED=y
# CONFIG_WASMOS_PM_LIST_ARRAY_CHUNK is not set
# CONFIG_WASMOS_IRQ_PIC is not set
# CONFIG_WASMOS_IRQ_LAPIC is not set
CONFIG_WASMOS_IRQ_IOAPIC=y
CONFIG_WASMOS_SMP=y
CONFIG_WASMOS_SCHED_CALLER_CPU_BIAS=y
CONFIG_WASMOS_WASM_RUNTIME_WASM3=y
# CONFIG_WASMOS_WASM_RUNTIME_WARP is not set
CONFIG_KERNEL_TARGET_TRIPLE="x86_64-elf"
CONFIG_QEMU_GDB_PORT=1234
# end of Build Options
