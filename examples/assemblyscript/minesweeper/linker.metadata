version = 1

[package]
name = "Minesweeper"
entry = "wasmos_main"
kind = "app"
native = false

[resources]
stack_pages = 8
heap_pages = 128

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# A libui board and its shared framebuffer window, which shmem_map_auto places
# above live data. asc declares one page unless told otherwise, and a window
# beyond that is outside linear memory.
[link]
initial_memory = 4194304

[ipc]
required_endpoint_name = "proc"
required_endpoint_rights = 0

[[capabilities]]
name = "ipc.basic"
flags = 0

[[capabilities]]
name = "dma.buffer"
flags = 0
