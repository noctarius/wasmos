version = 1

[package]
name = "gfx-smoke"
entry = "wasmos_main"
kind = "app"
native = false

[resources]
stack_pages = 16
heap_pages = 2048

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# A shared BGRA32 window buffer, which shmem_map_auto places above live data.
[link]
initial_memory = 8388608
max_memory = 8388608

[ipc]
required_endpoint_name = "proc"
required_endpoint_rights = 0

[[capabilities]]
name = "ipc.basic"
flags = 0

[[capabilities]]
name = "dma.buffer"
flags = 0
