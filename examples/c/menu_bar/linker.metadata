version = 1

[package]
name = "menu-bar"
entry = "wasmos_main"
kind = "app"
native = false

[resources]
stack_pages = 16
heap_pages = 512

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# A libui menu tree and its shared framebuffer window.
[link]
initial_memory = 4194304
max_memory = 4194304

[ipc]
required_endpoint_name = "proc"
required_endpoint_rights = 0

[[capabilities]]
name = "ipc.basic"
flags = 0

[[capabilities]]
name = "dma.buffer"
flags = 0

[[capabilities]]
name = "system.control"
flags = 0
