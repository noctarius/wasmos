version = 1

[package]
name = "net-tcp-echo"
entry = "wasmos_main"
kind = "app"
native = false
aot = true

[resources]
stack_pages = 16
heap_pages = 16

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# Room for the socket rings, overlaid into linear memory by
# wasmos_xfer_buffer_map above the 2 MiB floor and clear of the heap.
[link]
initial_memory = 4194304
max_memory = 4194304

[ipc]
required_endpoint_name = "proc"
required_endpoint_rights = 0

[[capabilities]]
name = "ipc.basic"
flags = 0
