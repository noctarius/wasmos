version = 1

[package]
name = "phys-map-refused"
entry = "wasmos_main"
kind = "app"
native = false

[resources]
stack_pages = 16
heap_pages = 16

[[capabilities]]
name = "ipc.basic"
flags = 0

# Holds mmio.map, so only the source-range rule can refuse it.
[[capabilities]]
name = "mmio.map"
flags = 0
