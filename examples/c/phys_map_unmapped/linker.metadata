version = 1

[package]
name = "phys-map-unmapped"
entry = "wasmos_main"
kind = "app"
native = false

[resources]
stack_pages = 16
heap_pages = 16

[[capabilities]]
name = "ipc.basic"
flags = 0

# phys_map requires it; the fixture exists to call phys_map.
[[capabilities]]
name = "mmio.map"
flags = 0
