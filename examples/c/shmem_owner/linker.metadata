version = 1

[package]
name = "shmownr"
entry = "wasmos_main"
kind = "app"
native = false

[resources]
stack_pages = 16
# shmem_map_auto scans for a window above the app's live data; its low guard is
# 2 MiB, so the linmem reserve (heap_pages * 4 KiB) must clear that. 512 pages =
# 2 MiB, matching the other shmem/DMA-capable apps (menu_bar, calculator).
heap_pages = 512

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# shmem_map_auto places its window above the app's live data, so the full
# 4 MiB is live from the start: a window at ~2 MiB in a one-page module would
# require a grow-on-access and trap.
[link]
initial_memory = 4194304
max_memory = 4194304

[ipc]
required_endpoint_name = "-"
required_endpoint_rights = 0

[[capabilities]]
name = "dma.buffer"
flags = 0
