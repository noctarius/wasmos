# WASMOS device-manager bootstrap rules (initfs), aarch64 (QEMU virt)
# Loaded from /init/devmgr/rules during early boot.
# udev-style syntax only.
SUBSYSTEM=="boot", RUN+="system/services/net_stack.wap"
SUBSYSTEM=="boot", RUN+="system/drivers/chardev_server.wap"
# The partition and volume managers run HERE, in the bootstrap set, because /boot
# is mounted from a volume: the boot rules that used to spawn them load from
# /boot itself, so nothing they published could ever select it. Neither names a
# disk -- both subscribe to the `block` class and act on what arrives -- so
# spawning them before any disk has registered is correct and not a race.
SUBSYSTEM=="boot", RUN+="system/drivers/partition_manager.wap"
SUBSYSTEM=="boot", RUN+="system/services/volume_manager.wap"
# virtio-blk carries /boot on QEMU virt and is supervised: a rule here is spawned
# from the initfs, so its restart reads the module from a filesystem it does not
# serve. Its rule is in this bootstrap set ONLY: loading the boot rules replaces
# the bootstrap PCI rules, and a copy there would bind the boot disk again.
# Transitional 0x1001 and modern 0x1042.
SUBSYSTEM=="pci", ATTR{vendor}=="0x1AF4", ATTR{device}=="0x1001", ENV{RESTART}="on-failure", RUN+="system/drivers/virtio_blk.wap"
SUBSYSTEM=="pci", ATTR{vendor}=="0x1AF4", ATTR{device}=="0x1042", ENV{RESTART}="on-failure", RUN+="system/drivers/virtio_blk.wap"
# /boot is the volume this system was LOADED FROM, whichever disk that is.
#
# ATTR{boot} is the only matcher that can say so. Every volume on the boot disk
# is FAT and an ESP's filesystem looks like any other: its label is
# firmware-specific ("QEMU VVFAT" here), an MBR carries no partition label and no
# PARTUUID, and a uuid would pin the rule to one built image. The identity that
# holds is the firmware's own -- the bootloader records the partition its device
# path names, the kernel publishes it as `boot.partition`, and the device manager
# marks the volume whose backing partition covers that LBA range.
#
# The volume names a PARTITION, so fs_fat is handed the partition device and has
# no table to parse.
SUBSYSTEM=="volume", ATTR{boot}=="1", ENV{MOUNT}="/boot", RUN+="system/drivers/fs_fat.wap"
