# WASMOS device-manager bootstrap rules (initfs)
# Loaded from /init/devmgr/rules during early boot.
# udev-style syntax only.
SUBSYSTEM=="boot", RUN+="system/services/net_stack.wap"
SUBSYSTEM=="boot", RUN+="system/drivers/chardev_server.wap"
# The partition and volume managers run HERE, in the bootstrap set, because /boot
# is mounted from a volume: the boot rules that used to spawn them load from
# /boot itself, so nothing they published could ever select it. Neither names a
# disk -- both subscribe to the `block` class and act on what arrives -- so
# spawning them before any disk has registered is correct and not a race.
SUBSYSTEM=="boot", RUN+="system/drivers/partition_manager.wap"
SUBSYSTEM=="boot", RUN+="system/services/volume_manager.wap"
SUBSYSTEM=="pci", ATTR{class}=="0x01", ATTR{subclass}=="0x01", RUN+="system/drivers/ata.wap"
# DRIVER names the backend: a unit is backend-local, so an unqualified
# ATTR{unit}=="0" also matches a virtio-blk device's only disk and would
# mount a second filesystem on /boot.
#
# The matcher that belongs here is `SUBSYSTEM=="volume", ATTR{boot}=="1"` -- the
# volume the FIRMWARE loaded this system from -- and everything it needs works:
# the bootloader records the partition its device path names, the kernel
# publishes it as `boot.partition`, and the device manager marks the volume
# covering that LBA range. Swapping this line selects the ESP on the first try.
#
# What it exposes is a yield-spin. A volume rule mounts /boot later than a block
# rule does, and the kernel's broker self-test spins on PROCESS_RUN_YIELDED until
# `font-service` is ready -- a service that comes FROM /boot. The boot then never
# completes. Fix the spin first; see docs/TASKS.md.
SUBSYSTEM=="block", DRIVER=="ata", ATTR{unit}=="0", ENV{MOUNT}="/boot", RUN+="system/drivers/fs_fat.wap"
