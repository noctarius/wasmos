# WASMOS device-manager persistent rules (boot FAT)
# Loaded from /boot/system/devmgr/rules after storage is online.
# Entries here are intended to override or extend initfs bootstrap rules.
# DRIVER names the backend; see the initfs rules for why an unqualified unit
# is ambiguous once more than one block backend is present.
SUBSYSTEM=="block", DRIVER=="ata", ATTR{unit}=="1", ENV{MOUNT}="/user", RUN+="system/drivers/fs_fat.wap"
# The WFS volume is a raw image on its own disk (build/wfs.img, ATA unit 2), so it
# needs its own backend: fs_fat cannot read it and would refuse the mount. The
# DRIVER qualifier matters here for the same reason it does above -- unit 2 alone
# would also match a second backend's unit 2.
SUBSYSTEM=="block", DRIVER=="ata", ATTR{unit}=="2", ENV{MOUNT}="/wfs", RUN+="system/drivers/fs_wfs.wap"
# The same WFS volume reached over a different transport. A virtio-blk unit is
# (slot << 3) | function, so unit 48 is PCI slot 6 function 0 -- the slot the
# test pins its drive to. The unit is named exactly rather than left wildcard
# because a wildcard would also match the signature disk that test_virtio_blk
# attaches, and fs_wfs would spend the rule's whole retry budget failing to find
# a superblock on it. No rule can match on content: there is no matcher that
# reads a volume signature, which is why the transport and the slot have to say
# which disk this is.
SUBSYSTEM=="block", DRIVER=="virtio-blk", ATTR{unit}=="48", ENV{MOUNT}="/vwfs", RUN+="system/drivers/fs_wfs.wap"
SUBSYSTEM=="pci", ATTR{class}=="0x03", ATTR{subclass}=="0x00", ATTR{prog_if}=="0x00", RUN+="system/drivers/fbpci.wap"
SUBSYSTEM=="acpi", ATTR{class}=="0x07", ATTR{subclass}=="0x00", RUN+="system/drivers/serial.wap"
SUBSYSTEM=="acpi", ATTR{class}=="0x09", ATTR{subclass}=="0x00", RUN+="system/drivers/keyboard.wap"
SUBSYSTEM=="acpi", ATTR{class}=="0x09", ATTR{subclass}=="0x02", RUN+="system/drivers/mouse.wap"
SUBSYSTEM=="acpi", ATTR{class}=="0x08", ATTR{subclass}=="0x03", RUN+="system/drivers/rtc.wap"
SUBSYSTEM=="pci", ATTR{class}=="0x02", ATTR{subclass}=="0x00", ATTR{vendor}=="0x1AF4", RUN+="system/drivers/virtio_net.wap"
SUBSYSTEM=="pci", ATTR{class}=="0x07", ATTR{subclass}=="0x00", ATTR{prog_if}=="0x00", ATTR{vendor}=="0x1AF4", RUN+="system/drivers/virtio_serial.wap"
# virtio-rng presents PCI class 0x00 / subclass 0xFF; 0xFF reads as the matcher's
# "any" wildcard, so match on vendor/device IDs (transitional 0x1005, modern 0x1044).
SUBSYSTEM=="pci", ATTR{vendor}=="0x1AF4", ATTR{device}=="0x1005", RUN+="system/drivers/virtio_rng.wap"
SUBSYSTEM=="pci", ATTR{vendor}=="0x1AF4", ATTR{device}=="0x1044", RUN+="system/drivers/virtio_rng.wap"
# virtio-blk presents PCI class 0x01 / subclass 0x00, which the ATA rule's
# 0x01/0x01 does not match; the vendor/device pair is matched anyway so a
# non-virtio SCSI controller is not handed to this driver (transitional 0x1001,
# modern 0x1042).
SUBSYSTEM=="pci", ATTR{vendor}=="0x1AF4", ATTR{device}=="0x1001", RUN+="system/drivers/virtio_blk.wap"
SUBSYSTEM=="pci", ATTR{vendor}=="0x1AF4", ATTR{device}=="0x1042", RUN+="system/drivers/virtio_blk.wap"
