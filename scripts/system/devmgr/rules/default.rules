# WASMOS device-manager persistent rules (boot FAT)
# Loaded from /boot/system/devmgr/rules after storage is online.
# Entries here are intended to override or extend initfs bootstrap rules.
# /user is one specific FAT volume, wherever it is. The rule names no disk, no
# unit, no backend, no partition and no position in the table: move the image to
# another controller, add a disk ahead of it, repartition around it, and the
# volume still mounts here because the uuid travels with the volume.
#
# The uuid is the FAT volume serial, and it is deterministic rather than
# arbitrary: scripts/make_gpt_image.py writes zlib.crc32(label) into the extended
# boot record, so crc32(b"user") == 0x8d93d649 and this rule spells the ON-DISK
# byte order, 49d6938d. DOS-lineage tools display it the other way round
# (8D93-D649), so read it off the volume manager's own report, not from `fatlabel`.
#
# SUBSYSTEM=="volume" rather than "partition": this matches what the volume IS,
# so the same rule form covers a formatted whole disk and a formatted partition
# alike. The tradeoff against ATTR{partlabel} is durability -- a GPT partition
# name survives a reformat of the volume, this serial does not -- against reach,
# since a partition label only exists where there is a partition table.
SUBSYSTEM=="volume", ATTR{uuid}=="49d6938d", ENV{MOUNT}="/user", RUN+="system/drivers/fs_fat.wap"
# The partition and volume managers are NOT spawned here. They live in the initfs
# bootstrap rules, because this file loads from /boot and /boot is itself selected
# by a volume -- a manager spawned from here could never publish the volume that
# mounts the filesystem it was spawned from.
# /wfs is one specific WFS volume, wherever it is. The rule names no disk, no
# unit, no backend, no partition and no transport: the volume manager recognises
# the filesystem from its superblock and publishes a volume, and this matches
# what that volume IS.
#
# This is the case the block layer could not express. The WFS image is written
# straight to a device with no partition table, so the partition manager
# publishes nothing for it and no SUBSYSTEM=="partition" rule can name it --
# leaving only DRIVER=="ata", ATTR{unit}=="2", which is a disk and a unit, the
# thing mount policy set out to stop naming.
#
# ATTR{fstype} alone would NOT do here, because there are two WFS volumes on this
# system and a rule fires once: whichever was recognised first would take /wfs and
# the ordering would decide which filesystem the path means. The uuid is the
# volume's own identity, pinned by mkfs_wfs (WFS_IMAGE_UUID in CMakeLists.txt),
# and it moves with the volume to any disk or transport.
SUBSYSTEM=="volume", ATTR{fstype}=="wfs", ATTR{uuid}=="5746532d-7465-4573-742d-766f6c756d65", ENV{MOUNT}="/wfs", RUN+="system/drivers/fs_wfs.wap"
# The second WFS volume, which the suite reaches over virtio-blk. Nothing here
# says virtio: this rule and the one above differ only in WHICH VOLUME they name,
# so the pair is what demonstrates that a transport is not part of a volume's
# identity -- move either image to the other controller and each still mounts at
# its own path.
#
# The uuid is WFS_VIRTIO_IMAGE_UUID, and pinning it is why the two images exist
# separately rather than one file attached twice: one file carries one identity,
# and policy could not tell the two mounts apart.
SUBSYSTEM=="volume", ATTR{fstype}=="wfs", ATTR{uuid}=="5746532d-7669-7274-696f-2d766f6c3031", ENV{MOUNT}="/vwfs", RUN+="system/drivers/fs_wfs.wap"
SUBSYSTEM=="pci", ATTR{class}=="0x03", ATTR{subclass}=="0x00", ATTR{prog_if}=="0x00", RUN+="system/drivers/fbpci.wap"
SUBSYSTEM=="acpi", ATTR{class}=="0x07", ATTR{subclass}=="0x00", RUN+="system/drivers/serial.wap"
SUBSYSTEM=="acpi", ATTR{class}=="0x09", ATTR{subclass}=="0x00", RUN+="system/drivers/keyboard.wap"
SUBSYSTEM=="acpi", ATTR{class}=="0x09", ATTR{subclass}=="0x02", RUN+="system/drivers/mouse.wap"
SUBSYSTEM=="acpi", ATTR{class}=="0x08", ATTR{subclass}=="0x03", RUN+="system/drivers/rtc.wap"
SUBSYSTEM=="pci", ATTR{class}=="0x02", ATTR{subclass}=="0x00", ATTR{vendor}=="0x1AF4", RUN+="system/drivers/virtio_net.wap"
SUBSYSTEM=="pci", ATTR{class}=="0x07", ATTR{subclass}=="0x00", ATTR{prog_if}=="0x00", ATTR{vendor}=="0x1AF4", RUN+="system/drivers/virtio_serial.wap"
# virtio-rng presents PCI class 0x00 / subclass 0xFF; 0xFF reads as the matcher's
# "any" wildcard, so match on vendor/device IDs (transitional 0x1005, modern 0x1044).
SUBSYSTEM=="pci", ATTR{vendor}=="0x1AF4", ATTR{device}=="0x1005", RUN+="system/drivers/virtio_rng.wap"
SUBSYSTEM=="pci", ATTR{vendor}=="0x1AF4", ATTR{device}=="0x1044", RUN+="system/drivers/virtio_rng.wap"
# virtio-blk presents PCI class 0x01 / subclass 0x00, which the ATA rule's
# 0x01/0x01 does not match; the vendor/device pair is matched anyway so a
# non-virtio SCSI controller is not handed to this driver (transitional 0x1001,
# modern 0x1042).
SUBSYSTEM=="pci", ATTR{vendor}=="0x1AF4", ATTR{device}=="0x1001", RUN+="system/drivers/virtio_blk.wap"
SUBSYSTEM=="pci", ATTR{vendor}=="0x1AF4", ATTR{device}=="0x1042", RUN+="system/drivers/virtio_blk.wap"

# Two tmpfs instances placed by rule, which is what ENV{MOUNT} on a boot rule is
# for: a filesystem with no backing device names no device, so nothing about it
# implies where it belongs and it can only be told.
#
# /home/user is a mount at DEPTH whose ancestors are ordinary directories in the
# root filesystem: fs-manager creates /home and then /home/user in the tmpfs
# mounted at /, which is a different path through fsmgr_ensure_mount_points than
# a top-level mount takes.
SUBSYSTEM=="boot", ENV{MOUNT}="/home/user", RUN+="system/drivers/fs_tmpfs.wap"
# /wfs/nested is a mount INSIDE another mount. Its mount point is created in the
# WFS volume rather than in the root filesystem, and it SHADOWS what the volume
# already holds there (scripts/wfs/nested/covered.txt): a path under the mount
# point reaches the tmpfs, so the WFS file beneath is unreachable while the mount
# stands. That is the Linux rule, and it is why a mount cannot fail because
# someone left a file behind.
SUBSYSTEM=="boot", ENV{MOUNT}="/wfs/nested", RUN+="system/drivers/fs_tmpfs.wap"
