# sysinit.rc -- boot-time service startup script
# Processed by sysinit using the wasmos script engine.

echo "Starting system services..."

spawn /boot/apps/chardevc.wap

start /boot/system/services/vt.wap

# The kernel log, appended to /var/log/messages on the tmpfs root from the first
# boot line on (the logger reads the kernel's ring from its oldest byte).
exec /boot/system/utils/mkdir.wap -p /var/log
if -f /boot/system/services/logger.wap then
    spawn /boot/system/services/logger.wap
endif

# gfxcomp, vt and cli follow their peers by name, so the services above and
# below may start in any order.  The gfx apps still resolve "gfx" with a
# one-shot retry loop of their own, hence the wait before them.
if -f /boot/system/services/fontsvc.wap then
    spawn /boot/system/services/fontsvc.wap
endif

spawn /boot/system/services/gfxcomp.wap
wait-svc gfx

if -f /boot/apps/menu_bar.wap then
    spawn /boot/apps/menu_bar.wap
endif

if -f /boot/apps/gfx_smoke.wap then
    spawn /boot/apps/gfx_smoke.wap
endif

if -f /boot/apps/calculator.wap then
    spawn /boot/apps/calculator.wap
endif

# The console slot's shell, started last so the first prompt still means the
# system is up.  Shells for the other slots are not started here: the vt creates
# one on demand when a slot is first switched to or bound to serial, pinned to
# that slot.
start /boot/system/services/cli.wap
