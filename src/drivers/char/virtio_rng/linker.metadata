version = 1
aot = true

[package]
name = "virtio-rng"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
# region_alloc maps the request virtqueue ring + entropy pool into a window above
# live data; needs the same 512-page (2 MiB) reserve as the other DMA-capable
# drivers to clear map_auto's 2 MiB low guard. Paired with initial/max memory of
# 4 MiB in [link] below.
heap_pages = 512

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# Virtqueue ring, mapped above the 2 MiB floor.
[link]
initial_memory = 4194304
max_memory = 4194304

[deps]
needs = ["pci"]
provides = ["hrng"]

# The virtio-modern registers are device memory (BAR 4, region 0 below); the
# driver touches no I/O port.
[[capabilities]]
name = "mmio.map"
flags = 0

[[capabilities]]
name = "irq.route"
flags = 0

# flags = DMA budget in pages: ring (2) + entropy pool (1), rounded up.
[[capabilities]]
name = "dma.buffer"
flags = 4

# Required to claim the virtual service class "hrng" at registration time (PM
# gates class claims in SVC_IPC_REGISTER_DESC_REQ on CAP_SVC_CLASS_REGISTER).
[[capabilities]]
name = "svc.class"
flags = 0

# Region 0: BAR 4, where the device places its virtio-modern structures (common
# config, notify, ISR). device-manager resolves it to a memory-mapped window of
# the BAR's measured size; a device without it is not handed to this driver.
[[regions]]
kind = "bar"
index = 4
