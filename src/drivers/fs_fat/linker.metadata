version = 1
aot = true

[package]
name = "fs-fat"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
heap_pages = 16

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# FAT directory and cluster-chain scratch on top of the 8 KiB block buffer.
[link]
stack_size = 8192
initial_memory = 262144
max_memory = 262144

# Which disk this instance serves is not known at build time: it is resolved at
# run time from the `block` (or `volume`) service CLASS, at the instance encoding
# the (backend, unit) carried in the startup args.
[deps]
needs = ["class:block"]
wants = ["class:volume"]

[[capabilities]]
name = "ipc.basic"
flags = 0

[[capabilities]]
name = "svc.class"
flags = 0
