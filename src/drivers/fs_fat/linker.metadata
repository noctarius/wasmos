version = 1
aot = true

[package]
name = "fs-fat"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
heap_pages = 16

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# FAT directory and cluster-chain scratch on top of the 8 KiB block buffer.
[link]
stack_size = 8192
initial_memory = 262144
max_memory = 262144

[ipc]
required_endpoint_name = "block"
required_endpoint_rights = 1

[[capabilities]]
name = "ipc.basic"
flags = 0

[[capabilities]]
name = "svc.class"
flags = 0
