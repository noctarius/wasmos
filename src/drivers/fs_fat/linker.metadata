version = 1
aot = true

[package]
name = "fs-fat"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
heap_pages = 16

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# FAT directory and cluster-chain scratch on top of the 8 KiB block buffer.
[link]
stack_size = 8192
initial_memory = 262144
max_memory = 262144

# No endpoint is required by NAME, because which disk this instance serves is
# not known at spawn time. The process manager resolves required_endpoint_name
# before the driver runs, and a name resolves to one provider system-wide, so
# naming one here would both gate startup on that provider existing and limit
# this driver to it. The disk is resolved at run time from the `block` service
# CLASS, at the instance encoding the (backend, unit) carried in the startup
# args.
[ipc]
required_endpoint_name = "-"
required_endpoint_rights = 0

[[capabilities]]
name = "ipc.basic"
flags = 0

[[capabilities]]
name = "svc.class"
flags = 0
