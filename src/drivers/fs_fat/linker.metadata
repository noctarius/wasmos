version = 1
aot = true

[package]
name = "fs-fat"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
heap_pages = 16

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# FAT directory and cluster-chain scratch on top of the 8 KiB block buffer.
[link]
stack_size = 8192
initial_memory = 262144
max_memory = 262144

# No endpoint is required by NAME. This driver used to name "block", which the
# process manager resolves at spawn time -- so it could only ever be started
# once a provider held that one name, and only ever reach that provider. Its
# disk is resolved at run time from the `block` service CLASS instead, by the
# instance encoding the (backend, unit) the device manager spawned it for.
[ipc]
required_endpoint_name = "-"
required_endpoint_rights = 0

[[capabilities]]
name = "ipc.basic"
flags = 0

[[capabilities]]
name = "svc.class"
flags = 0
