version = 1
aot = true

[package]
name = "fs-wfs"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
heap_pages = 16

# Link-time memory in bytes (docs/toolchain.md). Larger than fs_fat's because a
# WFS block is up to 16 KiB (against FAT's 512-byte sector) and the driver holds
# one staged block plus a path-resolution context, a read staging buffer, and the
# open-file table.
[link]
stack_size = 16384
initial_memory = 524288
max_memory = 524288

# No endpoint is required by NAME. The `block` name retired when a disk became
# the pair (backend, unit): a name resolves to ONE provider system-wide, so it
# could only ever reach whichever backend claimed it. The process manager
# resolves required_endpoint_name before the driver runs, so naming a retired
# name kills the process before its entry export ("[wasmos-app] endpoint resolve
# failed"). The disk is resolved at run time from the `block` service CLASS, at
# the instance encoding the (backend, unit) carried in the startup args.
[ipc]
required_endpoint_name = "-"
required_endpoint_rights = 0

[[capabilities]]
name = "ipc.basic"
flags = 0

[[capabilities]]
name = "svc.class"
flags = 0
