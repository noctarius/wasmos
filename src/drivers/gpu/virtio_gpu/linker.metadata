version = 1
aot = true

[package]
name = "virtio-gpu"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
# The control ring and the command page are region_alloc'd above live data,
# which needs the 512-page (2 MiB) reserve the other DMA drivers carry to clear
# map_auto's 2 MiB low guard. Paired with initial/max memory of 4 MiB below.
heap_pages = 512

[link]
initial_memory = 4194304
max_memory = 4194304

# "pci" is wanted, not needed: without pci-bus the driver runs on INTx as the
# firmware left the function, or polls.
[deps]
wants = ["pci"]
provides = ["display"]

# The virtio-modern registers are device memory (BAR 4, region 0 below).
[[capabilities]]
name = "mmio.map"
flags = 0

# flags = DMA budget in pages: the control ring (2 at most) and the command
# page, with headroom. The scanout is not counted: it is the kernel's
# framebuffer, which the device reads as the resource's backing.
[[capabilities]]
name = "dma.buffer"
flags = 4

[[capabilities]]
name = "irq.route"
flags = 0

# Region 0: BAR 4, where the device places its virtio-modern structures.
[[regions]]
kind = "bar"
index = 4
