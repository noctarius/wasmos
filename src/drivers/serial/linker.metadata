version = 1
aot = true

[package]
name = "serial"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
heap_pages = 16

[deps]
provides = ["sin"]

[[capabilities]]
name = "io.port"
flags = 0

# The memory-mapped PL011's window (aarch64) is granted only with mmio.map.
[[capabilities]]
name = "mmio.map"
flags = 0

[[capabilities]]
name = "irq.route"
flags = 0
