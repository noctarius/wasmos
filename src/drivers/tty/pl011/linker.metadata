version = 1
aot = true

[package]
name = "pl011"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
heap_pages = 16

[deps]
provides = ["sin"]

# Its register window is device memory, granted only with mmio.map.
[[capabilities]]
name = "mmio.map"
flags = 0

[[capabilities]]
name = "irq.route"
flags = 0
