version = 1
aot = true

[package]
name = "virtio-input"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
# The event ring and buffer page are region_alloc'd above live data, which
# needs the 512-page (2 MiB) reserve the other DMA drivers carry to clear
# map_auto's 2 MiB low guard. Paired with initial/max memory of 4 MiB below.
heap_pages = 512

[link]
initial_memory = 4194304
max_memory = 4194304

# "pci" is wanted, not needed: without pci-bus the driver runs on INTx as the
# firmware left the function. A keyboard instance provides "kbd", a mouse
# instance "mouse"; which one is decided by the device's event bitmaps.
[deps]
wants = ["pci"]
provides = ["kbd", "mouse"]

# The virtio-modern registers are device memory (BAR 4, region 0 below).
[[capabilities]]
name = "mmio.map"
flags = 0

# flags = DMA budget in pages: the event ring (2 at most) and one page of event
# buffers, with headroom.
[[capabilities]]
name = "dma.buffer"
flags = 4

[[capabilities]]
name = "irq.route"
flags = 0

# Region 0: BAR 4, where the device places its virtio-modern structures.
[[regions]]
kind = "bar"
index = 4
