version = 1
aot = true

[package]
name = "virtio-net"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
# region_alloc maps the virtqueue rings into a window above live data; needs
# 512 pages (2 MiB) reserve to clear map_auto's 2 MiB low guard, like the other
# DMA-capable apps. Paired with INITIAL/MAX_MEMORY 4 MiB in CMakeLists.
heap_pages = 512

[ipc]
required_endpoint_name = "-"
required_endpoint_rights = 0
entry_arg_bindings = ["proc.endpoint"]

[[capabilities]]
name = "io.port"
flags = 0

[[capabilities]]
name = "irq.route"
flags = 0

# flags = DMA budget in pages: RX+TX rings + RX/TX pools (~70), with headroom.
[[capabilities]]
name = "dma.buffer"
flags = 80

# Required to publish the adapter-neutral net.ifc class through the
# descriptor-based service registration path.
[[capabilities]]
name = "svc.class"
flags = 0

[[matches]]
bus = "pci"
class = 0x02
subclass = 0x00
prog_if = "any"
vendor = 0x1AF4
device = "any"
io_port_min = 0x0CF8
io_port_max = 0x0CFF
priority = 100
