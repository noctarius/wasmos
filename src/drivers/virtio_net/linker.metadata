version = 1
aot = true

[package]
name = "virtio-net"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
# region_alloc maps the virtqueue rings into a window above live data; needs
# 512 pages (2 MiB) reserve to clear map_auto's 2 MiB low guard, like the other
# DMA-capable apps. Paired with INITIAL/MAX_MEMORY 4 MiB in CMakeLists.
heap_pages = 512

[ipc]
required_endpoint_name = "-"
required_endpoint_rights = 0
entry_arg_bindings = ["proc.endpoint"]

[[capabilities]]
name = "io.port"
flags = 0

[[capabilities]]
name = "irq.route"
flags = 0

# Grants DEVMGR_CAP_DMA -> the kernel gives this driver a BIDIR DMA window over
# low memory [0, 2 GiB), which region_alloc's capability_dma_range_allowed
# check requires for the virtqueue ring/pool allocations.
[[capabilities]]
name = "dma.buffer"
flags = 0

[[matches]]
bus = "pci"
class = 0x02
subclass = 0x00
prog_if = "any"
vendor = 0x1AF4
device = "any"
io_port_min = 0x0CF8
io_port_max = 0x0CFF
priority = 100
