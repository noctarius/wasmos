version = 1
aot = true

[package]
name = "virtio-net"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
# region_alloc maps the virtqueue rings into a window above live data; needs
# 512 pages (2 MiB) reserve to clear map_auto's 2 MiB low guard, like the other
# DMA-capable apps. Paired with INITIAL/MAX_MEMORY 4 MiB in CMakeLists.
heap_pages = 512

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# region_alloc places the virtqueue-ring window above the driver's live data
# (the map_auto low guard is 2 MiB), so the module carries 4 MiB like the
# shmem/DMA-capable apps. max_memory must be >= the region window's
# offset+size or warp_linmem_place_phys returns NO_WINDOW.
[link]
initial_memory = 4194304
max_memory = 4194304

[ipc]
required_endpoint_name = "-"
required_endpoint_rights = 0

[[capabilities]]
name = "io.port"
flags = 0

[[capabilities]]
name = "irq.route"
flags = 0

# flags = DMA budget in pages: RX+TX rings + RX/TX pools (~70), with headroom.
[[capabilities]]
name = "dma.buffer"
flags = 80

# Required to publish the adapter-neutral net.ifc class through the
# descriptor-based service registration path.
[[capabilities]]
name = "svc.class"
flags = 0
