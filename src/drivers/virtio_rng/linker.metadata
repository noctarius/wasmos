version = 1
aot = true

[package]
name = "virtio-rng"
entry = "initialize"
kind = "driver"
native = false

[resources]
stack_pages = 16
# region_alloc maps the request virtqueue ring + entropy pool into a window above
# live data; needs the same 512-page (2 MiB) reserve as the other DMA-capable
# drivers to clear map_auto's 2 MiB low guard. Paired with INITIAL/MAX_MEMORY
# 4 MiB in CMakeLists.
heap_pages = 512

[ipc]
required_endpoint_name = "-"
required_endpoint_rights = 0
entry_arg_bindings = ["proc.endpoint"]

[[capabilities]]
name = "io.port"
flags = 0

# flags = DMA budget in pages: ring (2) + entropy pool (1), rounded up.
[[capabilities]]
name = "dma.buffer"
flags = 4

# Required to claim the virtual service class "hrng" at registration time (PM
# gates class claims in SVC_IPC_REGISTER_DESC_REQ on CAP_SVC_CLASS_REGISTER).
[[capabilities]]
name = "svc.class"
flags = 0

# QEMU presents virtio-rng-pci as class 0x00 / subclass 0xFF, and the
# device-manager matcher reserves 0xFF/0xFFFF as its "any" wildcard, so class
# fields cannot reliably select this device. Match the vendor/device IDs instead
# (transitional entropy device 1AF4:1005); class/subclass default to "any".
[[matches]]
bus = "pci"
prog_if = "any"
vendor = 0x1AF4
device = 0x1005
io_port_min = 0x0CF8
io_port_max = 0x0CFF
priority = 100
