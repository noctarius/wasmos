#pragma once
/* compat/array — freestanding shadow of <array>
 *
 * Provides std::array<T,N> with operator[], front(), back(), data(), size(),
 * max_size(), empty(), begin()/cbegin(), end()/cend() and fill(), plus an
 * array<T,0> specialisation.  The tuple protocol for arrays (tuple_size,
 * tuple_element, get<I>, and the array+array tuple_cat overload that
 * RegPosArr.hpp's to_array() needs) lives in compat/tuple, not here.
 *
 * <array> is WARP's most-used container header (register tables, opcode
 * dispatch tables, RegPosArr).  Those uses are aggregate initialisation,
 * indexing, iteration and size queries only — no compiled WARP source calls
 * at(), rbegin()/rend(), swap(), or the relational operators, so none are
 * provided.
 *
 * Element access matches the standard: operator[] is unchecked, and reading a
 * default-initialised array of a trivial type reads indeterminate values.
 * Using a missing member (at(), reverse iterators, ==) is a compile error at
 * the call site, not a silent behaviour change. */

#include "type_traits"
#include "utility"
#include <stddef.h>

namespace std {

template <typename T, size_t N>
struct array {
    using value_type      = T;
    using size_type       = size_t;
    using reference       = T &;
    using const_reference = const T &;
    using pointer         = T *;
    using const_pointer   = const T *;
    using iterator        = T *;
    using const_iterator  = const T *;

    /* Public data member — aggregate-initialisation requires it. */
    T _data[N];

    /* Element access */
    constexpr reference       operator[](size_type i)       noexcept { return _data[i]; }
    constexpr const_reference operator[](size_type i) const noexcept { return _data[i]; }

    constexpr reference       front()       noexcept { return _data[0]; }
    constexpr const_reference front() const noexcept { return _data[0]; }

    constexpr reference       back()       noexcept { return _data[N-1]; }
    constexpr const_reference back() const noexcept { return _data[N-1]; }

    constexpr pointer       data()       noexcept { return _data; }
    constexpr const_pointer data() const noexcept { return _data; }

    /* Capacity */
    constexpr size_type size()     const noexcept { return N; }
    constexpr size_type max_size() const noexcept { return N; }
    constexpr bool      empty()    const noexcept { return N == 0; }

    /* Iterators */
    constexpr iterator       begin()  noexcept { return _data; }
    constexpr const_iterator begin()  const noexcept { return _data; }
    constexpr const_iterator cbegin() const noexcept { return _data; }

    constexpr iterator       end()    noexcept { return _data + N; }
    constexpr const_iterator end()    const noexcept { return _data + N; }
    constexpr const_iterator cend()   const noexcept { return _data + N; }

    /* Fill */
    void fill(const T &v) {
        for (size_type i = 0; i < N; ++i)
            _data[i] = v;
    }
};

/* Zero-size specialisation — rarely needed but avoids UB from T[0]. */
template <typename T>
struct array<T, 0> {
    /* One padding byte so that {{}} aggregate-brace initialisation works:
     * without any member the nested {} is "excess elements". */
    unsigned char _pad[1] = {};

    using value_type      = T;
    using size_type       = size_t;
    using reference       = T &;
    using const_reference = const T &;
    using pointer         = T *;
    using const_pointer   = const T *;
    using iterator        = T *;
    using const_iterator  = const T *;

    constexpr pointer       data()       noexcept { return nullptr; }
    constexpr const_pointer data() const noexcept { return nullptr; }
    constexpr size_type     size()       const noexcept { return 0; }
    constexpr size_type     max_size()   const noexcept { return 0; }
    constexpr bool          empty()      const noexcept { return true; }

    constexpr iterator       begin()  noexcept { return nullptr; }
    constexpr const_iterator begin()  const noexcept { return nullptr; }
    constexpr iterator       end()    noexcept { return nullptr; }
    constexpr const_iterator end()    const noexcept { return nullptr; }
};

} // namespace std
