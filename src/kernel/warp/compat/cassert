#pragma once
/* compat/cassert — freestanding shadow of <cassert>
 * In a bare-metal kernel there is no stderr or process abort.  A failed
 * assertion is a fatal invariant violation, so it routes to kpanic() — which
 * stops every CPU, dumps their contexts, and halts — instead of silently
 * spinning one CPU forever. The failing expression is the panic reason and the
 * source line is passed as the first context value. */

extern "C" {
#include "kpanic.h"
}

#undef assert

#ifdef NDEBUG
#  define assert(expr) ((void)(expr))
#else
#  define assert(expr) \
    do { \
        if (!(expr)) { \
            kpanic("assert failed: " #expr, (unsigned long long)__LINE__, 0ULL); \
        } \
    } while (0)
#endif
