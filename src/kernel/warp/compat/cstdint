#pragma once
/* compat/cstdint — freestanding shadow of <cstdint>
 *
 * Pulls in clang's own freestanding <stdint.h> and re-exports every fixed,
 * least, fast, pointer and max width typedef into namespace std, so WARP can
 * spell std::uint8_t, std::int32_t and friends.  <cstdint> is WARP's single
 * most-included system header; the typedefs are the entirety of what it uses.
 *
 * The types are the compiler's own, so they are exact, not approximations, and
 * std::uint32_t is the same type as ::uint32_t used across the rest of the
 * kernel.  The INT*_C/UINT*_C macros and the INT*_MIN/MAX limit macros are not
 * re-exported here; they arrive unqualified from <stdint.h> itself, which is
 * how WARP spells them (for example UINT8_MAX in RegPosArr.hpp). */

#include <stdint.h>

namespace std {
    using ::int8_t;
    using ::int16_t;
    using ::int32_t;
    using ::int64_t;
    using ::uint8_t;
    using ::uint16_t;
    using ::uint32_t;
    using ::uint64_t;
    using ::int_least8_t;
    using ::int_least16_t;
    using ::int_least32_t;
    using ::int_least64_t;
    using ::uint_least8_t;
    using ::uint_least16_t;
    using ::uint_least32_t;
    using ::uint_least64_t;
    using ::int_fast8_t;
    using ::int_fast16_t;
    using ::int_fast32_t;
    using ::int_fast64_t;
    using ::uint_fast8_t;
    using ::uint_fast16_t;
    using ::uint_fast32_t;
    using ::uint_fast64_t;
    using ::intptr_t;
    using ::uintptr_t;
    using ::intmax_t;
    using ::uintmax_t;
} // namespace std
