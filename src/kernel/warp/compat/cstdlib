#pragma once
/* compat/cstdlib — freestanding shadow of <cstdlib>
 * In a bare-metal kernel there is no process exit.  Only the symbols WARP
 * actually references are declared here. */

#include <stddef.h>

extern "C" {
    /* Declared here, defined against the kernel slab allocator: malloc in
     * warp/linker_stubs.cpp, realloc and free in warp/posix_kernel.c. */
    void *malloc(size_t size);
    void *realloc(void *ptr, size_t size);
    void  free(void *ptr);

    /* abort() panics (src/kernel/libc.c); it never returns. */
    [[noreturn]] void abort(void);
} // extern "C"

namespace std {
    using ::malloc;
    using ::realloc;
    using ::free;
    using ::abort;
} // namespace std
