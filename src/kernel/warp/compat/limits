#pragma once
/* compat/limits — freestanding shadow of <limits>
 *
 * Provides numeric_limits<T> with max(), min() and is_integer for every
 * standard integer type (char, the signed/unsigned char, short, int, long and
 * long long pairs) plus float and double.  WARP asks only for max():
 * Span.hpp uses numeric_limits<size_t>::max() as the "rest of the span"
 * sentinel, Frontend.cpp compares against numeric_limits<uint8_t>::max(), and
 * RegMask.hpp builds its all-ones mask from numeric_limits<Type>::max().
 *
 * The specialisations name the fundamental types, not the <cstdint> typedefs:
 * each typedef is an alias of exactly one of them, which differs by target
 * (uint64_t is unsigned long on x86_64-elf and unsigned long long on Darwin),
 * so covering the fundamental types covers every typedef on every target
 * without a redefinition.  The bounds come from the compiler's limit macros.
 *
 * min() for the floating-point specialisations is __FLT_MIN__/__DBL_MIN__, the
 * smallest positive normal value, as the standard defines it; it is NOT the
 * most negative value, and there is no lowest().  Everything else the real
 * header carries (digits, epsilon, infinity, quiet_NaN, is_signed,
 * is_specialized, radix, ...) is absent and fails to compile at the point of
 * use. */

namespace std {

/* The primary template is declared and never defined: numeric_limits<T> for a
 * type without a specialisation below (bool, long double, wchar_t, an enum, a
 * pointer, a class type) is an incomplete type, and naming one of its members
 * is a compile error. */
template<class T> struct numeric_limits;

/* A cv-qualified T answers as T, as the standard specifies.  For an unknown T
 * the derivation from an incomplete base is itself a compile error. */
template<class T> struct numeric_limits<const T> : numeric_limits<T> {};
template<class T> struct numeric_limits<volatile T> : numeric_limits<T> {};
template<class T> struct numeric_limits<const volatile T> : numeric_limits<T> {};

#define WASMOS_NLIM_UINT(T, MAX) \
template<> struct numeric_limits<T> { \
    static constexpr T max() noexcept { return (T)(MAX); } \
    static constexpr T min() noexcept { return (T)0; } \
    static constexpr bool is_integer = true; \
};
#define WASMOS_NLIM_SINT(T, MAX) \
template<> struct numeric_limits<T> { \
    static constexpr T max() noexcept { return (T)(MAX); } \
    static constexpr T min() noexcept { return (T)(-(MAX)-1); } \
    static constexpr bool is_integer = true; \
};

WASMOS_NLIM_UINT(unsigned char,      __SCHAR_MAX__ * 2u + 1u)
WASMOS_NLIM_UINT(unsigned short,     __SHRT_MAX__ * 2u + 1u)
WASMOS_NLIM_UINT(unsigned int,       __INT_MAX__ * 2u + 1u)
WASMOS_NLIM_UINT(unsigned long,      __LONG_MAX__ * 2ul + 1ul)
WASMOS_NLIM_UINT(unsigned long long, __LONG_LONG_MAX__ * 2ull + 1ull)
WASMOS_NLIM_SINT(signed char,        __SCHAR_MAX__)
WASMOS_NLIM_SINT(short,              __SHRT_MAX__)
WASMOS_NLIM_SINT(int,                __INT_MAX__)
WASMOS_NLIM_SINT(long,               __LONG_MAX__)
WASMOS_NLIM_SINT(long long,          __LONG_LONG_MAX__)
#ifdef __CHAR_UNSIGNED__
WASMOS_NLIM_UINT(char,               __SCHAR_MAX__ * 2u + 1u)
#else
WASMOS_NLIM_SINT(char,               __SCHAR_MAX__)
#endif

#undef WASMOS_NLIM_UINT
#undef WASMOS_NLIM_SINT

template<> struct numeric_limits<float> {
    static constexpr float max() noexcept { return __FLT_MAX__; }
    static constexpr float min() noexcept { return __FLT_MIN__; }
    static constexpr bool is_integer = false;
};
template<> struct numeric_limits<double> {
    static constexpr double max() noexcept { return __DBL_MAX__; }
    static constexpr double min() noexcept { return __DBL_MIN__; }
    static constexpr bool is_integer = false;
};

} // namespace std
