#pragma once
/* compat/memory — freestanding shadow of <memory>
 *
 * Provides default_delete, unique_ptr (with a T[] deleter specialisation),
 * make_unique, addressof and align.  MemWriter.cpp is the only WARP source
 * that includes <memory>, and the only name it takes from it is std::align;
 * unique_ptr and make_unique are here for kernel-side WARP glue and are not
 * driven by an observed WARP call site.
 *
 * unique_ptr is a working owning pointer, not a stub: it releases in its
 * destructor, moves, and refuses to copy.  It routes through the global
 * operator delete defined in warp/shim.cpp, so ownership must have come from
 * the matching operator new.  Deviations to know about, all of which fail to
 * compile rather than misbehave: only default_delete has a T[] specialisation,
 * so unique_ptr<T[]> itself does not work (the primary template forms a
 * pointer-to-array that never matches the deleter); and there is no
 * deleter-argument constructor, no get_deleter(), no operator[], and no
 * comparison against another unique_ptr.
 *
 * std::shared_ptr, std::weak_ptr, std::allocator and the uninitialized_*
 * algorithms are absent; using them is a compile error. */
#include "type_traits"
#include "utility"

namespace std {

template<class T>
struct default_delete {
    void operator()(T *p) const noexcept { delete p; }
};
template<class T>
struct default_delete<T[]> {
    void operator()(T *p) const noexcept { delete[] p; }
};

template<class T, class D = default_delete<T>>
class unique_ptr {
    T *ptr_ = nullptr;
    D  del_;
public:
    using pointer      = T *;
    using element_type = T;
    using deleter_type = D;

    constexpr unique_ptr() noexcept = default;
    constexpr unique_ptr(decltype(nullptr)) noexcept : ptr_(nullptr) {}
    explicit  unique_ptr(T *p) noexcept : ptr_(p) {}
    unique_ptr(unique_ptr &&o) noexcept : ptr_(o.release()), del_(move(o.del_)) {}
    unique_ptr(const unique_ptr &) = delete;
    ~unique_ptr() noexcept { if (ptr_) del_(ptr_); }

    unique_ptr &operator=(unique_ptr &&o) noexcept {
        if (this != &o) { reset(o.release()); del_ = move(o.del_); }
        return *this;
    }
    unique_ptr &operator=(decltype(nullptr)) noexcept { reset(); return *this; }
    unique_ptr &operator=(const unique_ptr &) = delete;

    T *get()    const noexcept { return ptr_; }
    T *release() noexcept { T *p = ptr_; ptr_ = nullptr; return p; }
    void reset(T *p = nullptr) noexcept { if (ptr_) del_(ptr_); ptr_ = p; }
    void swap(unique_ptr &o) noexcept { T *t = ptr_; ptr_ = o.ptr_; o.ptr_ = t; }

    T &operator*()  const noexcept { return *ptr_; }
    T *operator->() const noexcept { return ptr_; }
    explicit operator bool() const noexcept { return ptr_ != nullptr; }
    bool operator==(decltype(nullptr)) const noexcept { return !ptr_; }
    bool operator!=(decltype(nullptr)) const noexcept { return  ptr_; }
};

template<class T, class... Args>
unique_ptr<T> make_unique(Args&&... args) {
    return unique_ptr<T>(new T(forward<Args>(args)...));
}

// addressof — returns address of object regardless of operator& overload
template<class T>
T *addressof(T &r) noexcept { return __builtin_addressof(r); }

// std::align — adjusts ptr and space for alignment.  Returns nullptr and leaves
// ptr/space untouched when the aligned block would not fit, as the standard
// requires.  The mask arithmetic assumes a power-of-two alignment; any other
// value silently misaligns instead of failing.  MemWriter.cpp is the caller,
// and it passes size 0, i.e. it asks only for the aligned address.
inline void *align(size_t alignment, size_t size, void *&ptr, size_t &space) noexcept {
    uintptr_t p = reinterpret_cast<uintptr_t>(ptr);
    uintptr_t aligned = (p + alignment - 1u) & ~(alignment - 1u);
    size_t offset = static_cast<size_t>(aligned - p);
    if (offset + size > space) return nullptr;
    space -= offset;
    ptr = reinterpret_cast<void *>(aligned);
    return ptr;
}

} // namespace std
