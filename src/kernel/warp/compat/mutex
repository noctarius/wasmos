#pragma once
/* compat/mutex — freestanding no-op stub of <mutex>
 *
 * Provides mutex, unique_lock<M> and lock_guard<M>.  That is the whole <mutex>
 * surface WARP reaches: WasmModule guards linear-memory reallocation with a
 * std::mutex plus std::unique_lock, and RAIISignalHandler (reachable through
 * WasmModule.cpp, but with no inline body used in this build) uses
 * std::lock_guard.  recursive_mutex, timed_mutex, std::lock, std::try_lock,
 * std::call_once and the defer_lock/try_to_lock/adopt_lock tags are absent, and
 * a use of any of them is a compile error at the call site.
 *
 * THE LOCKS DO NOT LOCK.  mutex::lock/unlock are empty and try_lock always
 * succeeds; unique_lock and lock_guard are faithful RAII wrappers around those
 * no-ops, so ownership tracking and destructor ordering behave as written but
 * exclude nothing.  This is safe only under the WARP single-CPU invariant —
 * at most one CPU inside WARP at any time — which is the same assumption the
 * per-CPU-slot context stack in warp/sjlj_unwind.cpp rests on.
 *
 * That invariant is an assumption, not an enforced property:
 * warp_runtime_enter/leave in warp/shim.cpp only rebinds the per-CPU heap PID
 * and takes no lock (see the FIXME(smp-warp) there).  It holds today because
 * WARP modules run on CPU 0.  If WARP modules ever execute on APs, these
 * no-ops stop protecting WasmModule's linear-memory realloc and the failure is
 * silent data corruption under concurrency, not a compile or link error — the
 * lock bodies here, or a real lock in warp_runtime_enter, must come first. */

namespace std {

// ---------------------------------------------------------------------------
// mutex — no-op
// ---------------------------------------------------------------------------

class mutex {
public:
    constexpr mutex() noexcept = default;

    /* Not copyable or movable (mirrors std::mutex). */
    mutex(const mutex &) = delete;
    mutex &operator=(const mutex &) = delete;

    void lock()     noexcept {}
    void unlock()   noexcept {}
    bool try_lock() noexcept { return true; }
};

// ---------------------------------------------------------------------------
// unique_lock<M> — no-op RAII wrapper
// ---------------------------------------------------------------------------

template <typename Mutex>
class unique_lock {
public:
    using mutex_type = Mutex;

    unique_lock() noexcept : _mutex(nullptr), _owns(false) {}

    explicit unique_lock(Mutex &m) noexcept : _mutex(&m), _owns(true) {
        m.lock();
    }

    unique_lock(unique_lock &&o) noexcept : _mutex(o._mutex), _owns(o._owns) {
        o._mutex = nullptr;
        o._owns  = false;
    }

    unique_lock &operator=(unique_lock &&o) noexcept {
        if (_owns && _mutex) _mutex->unlock();
        _mutex  = o._mutex;
        _owns   = o._owns;
        o._mutex = nullptr;
        o._owns  = false;
        return *this;
    }

    ~unique_lock() noexcept {
        if (_owns && _mutex) _mutex->unlock();
    }

    void lock()   noexcept { if (_mutex) { _mutex->lock();   _owns = true;  } }
    void unlock() noexcept { if (_mutex && _owns) { _mutex->unlock(); _owns = false; } }

    bool owns_lock() const noexcept { return _owns; }
    explicit operator bool() const noexcept { return _owns; }

    Mutex *mutex() const noexcept { return _mutex; }

private:
    Mutex *_mutex;
    bool   _owns;
};

// ---------------------------------------------------------------------------
// lock_guard<M> — scoped RAII wrapper
// ---------------------------------------------------------------------------

template <typename Mutex>
class lock_guard {
public:
    using mutex_type = Mutex;

    explicit lock_guard(Mutex &m) noexcept : _mutex(m) { m.lock(); }

    ~lock_guard() noexcept { _mutex.unlock(); }

    lock_guard(const lock_guard &) = delete;
    lock_guard &operator=(const lock_guard &) = delete;

private:
    Mutex &_mutex;
};

} // namespace std
