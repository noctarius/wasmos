#pragma once
/* compat/new — freestanding shadow of <new>
 *
 * Provides placement new/delete (scalar and array forms), std::bad_alloc and
 * std::nothrow_t/std::nothrow.  That matches what the WARP sources including
 * <new> need: WasmModule.cpp and ExecutableMemory.hpp construct objects in
 * place, and VirtualMemoryAllocator.cpp throws std::bad_alloc.
 *
 * Allocating forms of operator new/delete are deliberately NOT declared here.
 * The kernel defines the global ones in warp/shim.cpp, backed by the kernel
 * slab allocator, and they are visible without any declaration because the
 * compiler declares them implicitly.
 *
 * std::align_val_t, the sized/aligned overloads, std::get_new_handler and
 * std::launder are absent; using them is a compile error. */

#include <stddef.h>

/* Placement new — must live in the global namespace, not inside a header
 * guard that redefines it.  Guard with a macro so double-inclusion is safe. */
#ifndef WASMOS_COMPAT_NEW_PLACEMENT
#define WASMOS_COMPAT_NEW_PLACEMENT
inline void *operator new  (size_t, void *p) noexcept { return p; }
inline void *operator new[](size_t, void *p) noexcept { return p; }
inline void  operator delete  (void *, void *) noexcept {}
inline void  operator delete[](void *, void *) noexcept {}
#endif /* WASMOS_COMPAT_NEW_PLACEMENT */

namespace std {

/* Minimal bad_alloc — what() returns a static string.  It is thrown for real:
 * operator new returns nullptr on allocation failure rather than throwing, and
 * warp/mem_utils_kernel.cpp raises this on a failed page allocation.  The throw
 * lands on the WARP_CALL checkpoint in warp_driver.cpp (see warp/cxx_abi.cpp). */
class bad_alloc {
public:
    bad_alloc() noexcept {}
    bad_alloc(const bad_alloc &) noexcept {}
    bad_alloc &operator=(const bad_alloc &) noexcept { return *this; }
    virtual ~bad_alloc() noexcept {}
    virtual const char *what() const noexcept { return "bad_alloc"; }
};

/* nothrow_t / nothrow — used by placement-new overloads in hosted headers.
 * Declaration only: no translation unit in the kernel WARP build defines the
 * `nothrow` object, so naming it links only as long as it stays unused.  A
 * `new (std::nothrow) T` in kernel-side WARP code therefore fails at link time
 * (undefined std::nothrow, plus no nothrow operator new is declared above),
 * not at runtime. */
struct nothrow_t { explicit nothrow_t() = default; };
extern const nothrow_t nothrow;

} // namespace std
