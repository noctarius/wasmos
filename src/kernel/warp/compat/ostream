#pragma once
/* Minimal <ostream> stub.  compat/iostream builds std::cout/std::cerr on it
 * (defined in warp/iostream_stubs.cpp); every insertion is discarded, so no
 * output is ever produced.  WARP's own std::cout users (utils/MemUtils.cpp,
 * utils/OSAPIChecker.cpp) are replaced by kernel translation units. */
namespace std {
struct ostream {
    template<class T> ostream &operator<<(T const &) noexcept { return *this; }
    ostream &operator<<(ostream &(*)(ostream &)) noexcept { return *this; }
};
inline ostream &endl(ostream &os) noexcept { return os; }
inline ostream &flush(ostream &os) noexcept { return os; }
} // namespace std
