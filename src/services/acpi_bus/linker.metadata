version = 1
aot = true

[package]
name = "acpi-bus"
entry = "initialize"
kind = "service"
native = false

[resources]
stack_pages = 64
heap_pages = 128

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# Room for a parsed ACPI table while it is walked.
[link]
stack_size = 16384
initial_memory = 131072
max_memory = 131072

[ipc]
required_endpoint_name = "proc"
required_endpoint_rights = 1

[[capabilities]]
name = "mmio.map"
flags = 0
