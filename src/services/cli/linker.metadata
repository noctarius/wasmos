version = 1
aot = true

[package]
name = "cli"
entry = "initialize"
kind = "service"
native = false
wants_tty = true

[resources]
stack_pages = 16
heap_pages = 16

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# Room for the script engine's line and variable buffers on top of the shell
# itself.
[link]
stack_size = 8192
initial_memory = 131072
max_memory = 131072

[deps]
needs = ["fs.vfs"]
wants = ["vt", "devmgr.query"]

[[capabilities]]
name = "system.control"
flags = 0

# The console user runs `svc`, which holds svc.control. A process may start a
# package holding svc.control only if it holds svc.control itself (or
# spawn.grant), so the shell holds it to run the utility for the user
# (docs/architecture/10-capability-and-policy.md, "Signed Packages").
[[capabilities]]
name = "svc.control"
flags = 0
