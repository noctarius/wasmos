version = 1
aot = true

[package]
name = "device-manager"
entry = "initialize"
kind = "service"
native = false

[resources]
stack_pages = 64
heap_pages = 64

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# Rule matching walks a nested match tree on the stack.
[link]
stack_size = 16384

[deps]
wants = ["fs.vfs"]
provides = ["devmgr.inv", "devmgr.query"]

[[capabilities]]
name = "ipc.basic"
flags = 0
