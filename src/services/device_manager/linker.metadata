version = 1
aot = true

[package]
name = "device-manager"
entry = "initialize"
kind = "service"
native = false

[resources]
stack_pages = 64
heap_pages = 64

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# Rule matching walks a nested match tree on the stack.
[link]
stack_size = 16384

[deps]
wants = ["fs.vfs"]
provides = ["devmgr.inv", "devmgr.query"]

[[capabilities]]
name = "ipc.basic"
flags = 0

# spawn.grant: driver spawns carry each driver's I/O windows, IRQ lines and DMA
# windows. svc.control: ENV{RESTART} rules submit their driver to the supervisor.
[[capabilities]]
name = "spawn.grant"
flags = 0

[[capabilities]]
name = "svc.control"
flags = 0
