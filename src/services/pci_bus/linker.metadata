version = 1
aot = true

[package]
name = "pci-bus"
entry = "initialize"
kind = "service"
native = false

[resources]
stack_pages = 64
heap_pages = 64

[ipc]
required_endpoint_name = "proc"
required_endpoint_rights = 1

[[capabilities]]
name = "io.port"
flags = 0

# pci-bus configures each PCI INTx line's trigger/polarity (level/active-low) in
# the IOAPIC via wasmos_irq_configure, gated by the IRQ capability.
# TODO: split a dedicated irq.configure capability from irq.route (docs 09).
[[capabilities]]
name = "irq.route"
flags = 0

# An MSI-X table lives in a device BAR, so binding a vector is a memory write
# rather than a config-space write (wasmos_mmio_write32). The kernel refuses any
# address overlapping system RAM, so this reaches device registers only.
[[capabilities]]
name = "mmio.map"
flags = 0
