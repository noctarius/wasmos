version = 1
aot = true

[package]
name = "pci-bus"
entry = "initialize"
kind = "service"
native = false

[resources]
stack_pages = 64
heap_pages = 64

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# Enumeration recurses through bridges on the stack.
[link]
stack_size = 16384

[deps]
needs = ["devmgr.inv"]
provides = ["pci"]

# pci.config: config space through the kernel, which serialises the
# 0xCF8/0xCFC port pair (pci_config_read / pci_config_write).
[[capabilities]]
name = "pci.config"
flags = 0

# pci-bus configures each PCI INTx line's trigger/polarity (level/active-low) in
# the IOAPIC via wasmos_irq_configure, gated by the IRQ capability.
# TODO: split a dedicated irq.configure capability from irq.route (docs 09).
[[capabilities]]
name = "irq.route"
flags = 0

# An MSI-X table lives in a device BAR, so binding a vector is a memory write
# rather than a config-space write (wasmos_mmio_write32). The kernel refuses any
# address overlapping system RAM, so this reaches device registers only.
[[capabilities]]
name = "mmio.map"
flags = 0

# Publishes every PCI function it finds to device-manager's inventory.
[[capabilities]]
name = "inventory.device"
flags = 0
