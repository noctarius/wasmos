version = 1
aot = true

[package]
name = "supervisor"
entry = "initialize"
kind = "service"
native = false

[resources]
stack_pages = 16
heap_pages = 16

# Spawned by kernel init right after the process manager, before anything it
# could supervise; it reaches the process manager through spawn-info alone.
[deps]
provides = ["supervisor"]

# system.control: a critical unit's death ends in the orderly halt.
[[capabilities]]
name = "system.control"
flags = 0

# spawn.grant: a unit's grants reach the process manager as the supervisor's
# own watched spawn; sv_authorize relays them only from a submitter that holds
# spawn.grant itself.
[[capabilities]]
name = "spawn.grant"
flags = 0
