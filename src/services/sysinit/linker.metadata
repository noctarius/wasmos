version = 1
aot = true

[package]
name = "sysinit"
entry = "initialize"
kind = "service"
native = false

[resources]
stack_pages = 64
heap_pages = 64

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# The startup script recurses through .rc includes; the deeper stack is for
# that, not for data.
[link]
stack_size = 16384

[[capabilities]]
name = "ipc.basic"
flags = 0

# svc.control: `service` lines submit units to the supervisor, and the end of
# the script declares the boot set.
[[capabilities]]
name = "svc.control"
flags = 0
