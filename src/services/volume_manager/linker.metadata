version = 1
aot = true

[package]
name = "volume-manager"
# The libsys async-service entry: it creates the reply endpoint, the event loop
# and the coroutine runtime, then pumps the root task this service supplies.
entry = "async_initialize"
# A service, not a driver, and the distinction is the I/O path. The partition
# manager ships as `kind = "driver"` because it proxies every transfer and a
# service-band proxy under a driver-band filesystem would be a priority
# inversion. Nothing reads a volume THROUGH this: the descriptor names the block
# device underneath and a client addresses that directly, so this sits beside the
# storage path rather than in it. See docs/architecture/37 §11.
kind = "service"
native = false

[resources]
stack_pages = 16
heap_pages = 512

# Link-time memory in bytes (docs/toolchain.md). No device memory is mapped here
# -- every disk is reached over IPC -- so it needs no window above the 2 MiB low
# guard and takes the modest default.
[link]
initial_memory = 4194304
max_memory = 4194304

[ipc]
required_endpoint_name = "-"
required_endpoint_rights = 0

# A block CLIENT plus a class provider, which is all this is: IPC to reach the
# disks and the process manager, and svc.class to subscribe to `block` and claim
# a `volume` instance per volume. No io.port, no irq.route, no dma.buffer -- it
# drives no device and reads only a bounded prefix of each volume.
[[capabilities]]
name = "ipc.basic"
flags = 0

[[capabilities]]
name = "svc.class"
flags = 0
