version = 1
aot = true

[package]
name = "vt"
entry = "initialize"
kind = "service"
native = false

[resources]
stack_pages = 16
# Raised from 16: heap_pages sets the WARP reserved-linmem slot (heap_size), the
# scan ceiling xfer_buffer_map uses to place the klog ring's overlay window
# (phase 4).  Kept UNDER the 2 MiB low-guard (mem_size < ~2.13 MiB) so the window
# is placed just above the VT's active memory (~a few hundred KiB) instead of at
# 2 MiB — a cheap page-fault-in rather than a multi-MiB commit that would stall
# the CLI handshake.  Must exceed the cell grids + the window + scan guards.
heap_pages = 256

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# The only app that grows: the terminal's cell grids are allocated as
# sessions open, so initial_memory covers the common case and max_memory the
# ceiling.
[link]
initial_memory = 1572864
max_memory = 4194304

[deps]
wants = ["fb", "kbd", "sin", "fs.vfs"]
provides = ["vt"]

[[capabilities]]
name = "ipc.basic"
flags = 0

# Registers the console ring (klog_register_ring): every tty's output and the
# kernel log arrive there, and the vt owns COM1 (serial_owner_write).
[[capabilities]]
name = "console.owner"
flags = 0

# The vt spawns the shell (cli) for each console slot past the first. A process
# may start a package holding an authority capability only if it holds that
# capability itself (or spawn.grant), so the vt holds the shell's two
# (docs/architecture/10-capability-and-policy.md, "Signed Packages").
[[capabilities]]
name = "system.control"
flags = 0

[[capabilities]]
name = "svc.control"
flags = 0
