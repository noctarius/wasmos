version = 1

[package]
name = "explorer"
entry = "wasmos_main"
kind = "app"
native = false

[resources]
stack_pages = 16
heap_pages = 256

# Link-time memory in bytes (docs/toolchain.md); omitted keys take the defaults.
# A libui window's component tree and its shared framebuffer window, which
# xfer_buffer_map places above live data.
[link]
initial_memory = 4194304
max_memory = 4194304

[ipc]
required_endpoint_name = "proc"
required_endpoint_rights = 0

[[capabilities]]
name = "ipc.basic"
flags = 0
