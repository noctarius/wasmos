version = 1

[package]
name = "umount"
entry = "wasmos_main"
kind = "app"
native = false
aot = true

[resources]
stack_pages = 16
heap_pages = 16

[ipc]
required_endpoint_name = "proc"
required_endpoint_rights = 0

# Only ipc.basic: one FSMGR_IPC_UNMOUNT_REQ to fs-manager, which owns the mount
# table and performs the removal itself. This tool is an ordinary client of that
# service and touches no device, no block backend and no filesystem content.
[[capabilities]]
name = "ipc.basic"
flags = 0
